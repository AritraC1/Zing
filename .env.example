# ===============
# FRONTEND/CLIENT
# ===============

# Base URL — use /api when running behind Docker nginx on port 80
VITE_BASE_URL=/api

# Socket URL — leave empty in Docker to use same origin (nginx proxies /socket.io)
VITE_SOCKET_URL=

# QRValue
VITE_QRVALUE=https://yourapp.com/login-session

# Firebase Credentials (Generate from firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Web Push certificate key for push notifications (Firebase console →
# Project settings → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Frontend URL for CORS + Socket.IO (Docker: http://localhost)
FRONTEND_URL=http://localhost

# ==============
# BACKEND/SERVER
# ==============

# PORT
PORT=3000

# Postgres DB URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5433/your_db_name

# Docker-only DB URL used by docker-compose (host name `postgres` on the
# compose network). Password special characters must be URL-encoded (e.g. @ → %40).
DATABASE_URL_DOCKER=postgresql://postgres:your_db_password@postgres:5432/your_db_name

# Optional Redis (Socket.IO fan-out adapter, presence TTL, distributed
# rate limiting). Leave unset for host-machine runs — Docker Compose
# injects redis://redis:6379 into the api container itself. Uncomment
# only if you run Redis directly on the host.
# REDIS_URL=redis://localhost:6379

# Group calls (mediasoup SFU)
# RTC UDP/TCP port range the SFU binds for WebRTC media. Docker Compose
# exposes these ports from the api container.
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100

# IP advertised to clients in ICE candidates. "auto" picks the primary
# network interface (fine locally); set your public/LAN IP in production
# or when running inside Docker.
SFU_ANNOUNCED_IP=auto

# JWT Secret
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret