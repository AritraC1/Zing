# ===============
# FRONTEND/CLIENT
# ===============

# Base URL — use /api when running behind Docker nginx on port 80
VITE_BASE_URL=/api

# Socket URL — leave empty in Docker to use same origin (nginx proxies /socket.io)
VITE_SOCKET_URL=

# QRValue
VITE_QRVALUE=https://yourapp.com/login-session

# Firebase Credentials (Generate from firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=# Frontend URL for CORS + Socket.IO (Docker: http://localhost)
FRONTEND_URL=http://localhost

# ==============
# BACKEND/SERVER
# ==============

# PORT
PORT=3000

# Postgres DB URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
DATABASE_URL=postgresql://postgres:your_db_password@postgres:5432/your_db_name

# JWT Secret
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret